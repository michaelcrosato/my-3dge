// The whole repository as one TypeScript program: what `npx tsc --noEmit`, editors, Vite, Vitest, tsx and `x new`
// read. T0 (`npm run check`, `npm run typecheck`) checks the same files through the projects of tsconfig.check.json,
// incrementally; tools/checkAll.test.ts keeps the two file lists equal (ADR-0014, amendment 7).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["engine", "labs", "tests", "fixtures", "tools", ".claude/hooks", "*.config.ts"]
}
