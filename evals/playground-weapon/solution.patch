+/**
+ * @file Unit tests for the playground's guns (labs/playground/weapons/guns.ts) beyond the range's
+ * (labs/playground/weapons/range.test.ts): the submachine gun's prop builds clean in the weapon's frame, and in a
+ * player's hands in a yard it empties its 18 rounds in a second of the trigger held, its last bringing the reload on,
+ * 2.45 s from empty, then fires on.
+ * @see labs/playground/weapons/guns.ts
+ */
+import { describe, expect, it } from 'vitest';
+import { buildPropPart, inspectGeometry, partMatrix } from '../../../engine';
+import { addWeapons, createCharacter, defineScene, getProp, physicsOf, spawnActor, weaponsFor, type WeaponsState } from '../../../engine/sim-api'; // prettier-ignore
+import { createSession } from '../../../engine/sim/session';
+import { PLAYGROUND_WEAPONS, SMG } from './guns';
+
+/** A yard: a floor, and a player holding the submachine gun drawn. */
+const yard = defineScene('guns-test:smg', {
+  physics: true,
+  setup(w) {
+    physicsOf(w).addBody({ type: 'fixed', colliders: [{ shape: { type: 'box', size: [40, 1, 40] }, position: [0, -0.5, 0] }] }); // prettier-ignore
+    spawnActor(w, { at: [0, 0, 0], character: createCharacter({ movement: 'movement:apex' }), player: true, components: { weapons: weaponsFor([SMG.id], 0) } }); // prettier-ignore
+    addWeapons(w);
+  },
+});
+
+describe('the submachine gun', () => {
+  it('is drawn as clean parts in the weapon’s frame, its grip under the origin, its barrel along +Z', () => {
+    const prop = getProp(SMG.prop);
+    let [front, low] = [0, 0];
+    for (const part of prop.parts) {
+      const report = inspectGeometry(buildPropPart(part).applyMatrix4(partMatrix(part)));
+      expect([report.missing, report.degenerate, report.flipped, report.badNormals], part.name).toEqual([[], 0, 0, 0]);
+      [front, low] = [Math.max(front, report.max[2]), Math.min(low, report.min[1])];
+    }
+    expect([prop.body.type, front > 0.25, low < -0.1]).toEqual(['none', true, true]);
+    expect(PLAYGROUND_WEAPONS).not.toContain(SMG.id); // nobody carries it yet
+  });
+
+  it('empties its 18 rounds in a second of the trigger held, reloads 2.45 s from empty, then fires on', () => {
+    const session = createSession(yard, { seed: 1 });
+    const weapons = () => (session.world.get(1) as unknown as { weapons: WeaponsState }).weapons;
+    for (let k = 0; k < 66; k++) session.step({ b: ['fire'], ...(k === 0 ? { p: ['fire'] } : {}) });
+    expect([weapons().shots, weapons().mags[0], weapons().reload >= 0]).toEqual([18, 0, true]);
+    for (let k = 0; k < 150; k++) session.step({ b: ['fire'] });
+    expect(weapons().shots).toBeGreaterThan(18);
+    expect(weapons().shots).toBeLessThan(24);
+  });
+});
