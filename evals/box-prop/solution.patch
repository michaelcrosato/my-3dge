+/**
+ * @file The prop `prop:waystone`: a stone that marks the box's paths, 1.4 m tall, its rune cap lighting the floor
+ * round it with a steady cold light. A square pillar of stone narrows from 0.4 m at its foot to 0.3 m under a glowing
+ * cap; it is fixed, so bodies stop against it and nothing knocks it over. A level places it on its spawn `waystone`.
+ *
+ * Invariants: its parts stand on its base (the origin, +Y up), in metres, built from geometry and materials by id
+ * (`node x describe geometry`, `node x describe material`); its body's shape stands on the base too, as tall as the
+ * parts; `node x qa geo tex --only prop:waystone` checks its parts and their textures.
+ *
+ * @example
+ * waystone.body.type; // 'fixed'
+ * @see labs/box/props/waystone.test.ts
+ */
+import { defineProp } from '../../../engine/sim-api';
+
+/** The prop `prop:waystone`: a 1.4 m stone pillar under a glowing rune cap, lighting the floor round it. */
+export const waystone = defineProp('prop:waystone', {
+  description: 'A waystone, 1.4 m tall: a stone pillar narrowing from 0.4 m to 0.3 m under a glowing rune cap. Fixed.',
+  parts: [
+    {
+      name: 'pillar',
+      geometry: 'geometry:frustum',
+      // a square, its sides along the axes: a four-sided frustum's corners lie on its radius, √2 times its half-width
+      params: { radiusBottom: 0.2 * Math.SQRT2, radiusTop: 0.15 * Math.SQRT2, height: 1.3, radialSegments: 4 },
+      material: 'material:stone',
+    },
+    {
+      name: 'cap',
+      geometry: 'geometry:box',
+      params: { width: 0.32, height: 0.1, depth: 0.32 },
+      material: 'material:glow',
+      tint: '#7fd4ff',
+      position: [0, 1.3, 0],
+      shadow: false,
+    },
+  ],
+  body: { type: 'fixed', shape: 'box', size: [0.4, 1.4, 0.4] },
+  light: { tag: 'waystone', color: '#7fd4ff', intensity: 2, distance: 5, position: [0, 1.5, 0], flicker: false },
+  place: { spawn: 'waystone' },
+  gallery: { camera: 'turntable', duration: 0, states: [] }, // node x gallery: four views round it
+});
