diff --git a/labs/box/scenes/crowd-hunters.ts b/labs/box/scenes/crowd-hunters.ts
new file mode 100644
index 0000000..9f23ffd
--- /dev/null
+++ b/labs/box/scenes/crowd-hunters.ts
@@ -0,0 +1,32 @@
+/**
+ * @file The hunters, a Box 4 variant (PLAN.md §9.0): the crowd scene (labs/box/scenes/crowd-1000.ts) with 200 of the
+ * mix `hunters`, six in ten walkers and four in ten wisps, no slimes: the crowd that chases the hero on foot and from
+ * the air, none hopping. A settings preset of the crowd's (`box.crowd.*`): the count 200 and the mix `hunters` unless
+ * set.
+ *
+ * Game code, sim-side: it imports only engine/sim-api.ts and the box's own files.
+ *
+ * @example
+ * // node x sim labs/box/scenes/crowd-hunters --steps 600
+ * // http://127.0.0.1:5173/labs/box/?scene=crowd-hunters&cam3=chase
+ * @see labs/box/scenes/crowd-1000.test.ts
+ */
+import { defineScene } from '../../../engine/sim-api';
+import { setupCrowd, type CrowdComponents } from './crowd-1000';
+import { boxSounds } from '../sounds/events';
+import { HALL_LEVEL } from './hall';
+
+/** The hunters: 200 walkers and wisps. */
+export const crowdHunters = defineScene<CrowdComponents>('box:crowd-hunters', {
+  description:
+    'Box 4, a variant: the hall with its hero and 200 hunters, six in ten walkers and four in ten wisps, that chase him on foot and from the air.',
+  level: 'level:hall',
+  sounds: boxSounds(HALL_LEVEL),
+  physics: true,
+  settings: { 'box.crowd.count': 200, 'box.crowd.mix': 'hunters' },
+  setup(w) {
+    setupCrowd(w);
+  },
+});
+
+export default crowdHunters;
