+/**
+ * @file Unit tests for the playground's radio (labs/playground/cast/radio.ts): before a player in a yard, it is what
+ * his use would use, the HUD saying it turns the radio on; a use turns it on (its event `radio` says so) and the next
+ * turns it off; its parts build clean; and the yard plays the same twice.
+ * @see labs/playground/cast/radio.ts
+ */
+import { describe, expect, it } from 'vitest';
+import { buildPropPart, inspectGeometry, partMatrix } from '../../../engine';
+import { addInteraction, createCharacter, defineScene, physicsOf, spawnActor } from '../../../engine/sim-api';
+import { createSession } from '../../../engine/sim/session';
+import { addRadio, RADIO, RADIO_PROMPTS, type RadioComponent } from './radio';
+
+/** A yard: a floor, a player at the origin facing +Z, and a radio 1 m before him. */
+const yard = defineScene('radio-test:yard', {
+  physics: true,
+  setup(w) {
+    physicsOf(w).addBody({ type: 'fixed', colliders: [{ shape: { type: 'box', size: [20, 1, 20] }, position: [0, -0.5, 0] }] }); // prettier-ignore
+    spawnActor(w, { at: [0, 0, 0], character: createCharacter({ movement: 'movement:apex' }), player: true }); // 1
+    addRadio(w, { at: [0, 0, 1] }); // 2
+    addInteraction(w);
+  },
+});
+
+type Entity = { interactor: { target: number; prompt: string }; radio: RadioComponent };
+
+describe('the radio', () => {
+  it('is what the player uses before it: a use turns it on, the next off, each with its event', () => {
+    const session = createSession(yard, { seed: 1 });
+    const get = (id: number) => session.world.get(id) as unknown as Entity;
+    session.step({});
+    session.step({});
+    expect([get(1).interactor.target, get(1).interactor.prompt, get(2).radio.on]).toEqual([2, RADIO_PROMPTS.off, false]); // prettier-ignore
+    session.step({ b: ['interact'] });
+    session.step({});
+    expect([get(2).radio.on, get(1).interactor.prompt]).toEqual([true, RADIO_PROMPTS.on]);
+    session.step({ b: ['interact'] });
+    session.step({});
+    const said = session.world.events
+      .trace()
+      .filter((e) => e.type === 'radio')
+      .map((e) => e.payload);
+    expect([get(2).radio.on, said]).toEqual([
+      false,
+      [
+        { id: 2, on: true },
+        { id: 2, on: false },
+      ],
+    ]);
+  });
+
+  it('builds clean parts on its base', () => {
+    for (const part of RADIO.parts) {
+      const report = inspectGeometry(buildPropPart(part).applyMatrix4(partMatrix(part)));
+      expect([report.missing, report.degenerate, report.flipped, report.badNormals], part.name).toEqual([[], 0, 0, 0]);
+      expect(report.min[1], part.name).toBeGreaterThanOrEqual(-1e-6);
+    }
+  });
+
+  it('plays the same twice', () => {
+    const run = () => {
+      const session = createSession(yard, { seed: 1 });
+      for (let k = 0; k < 30; k++) session.step(k === 3 ? { b: ['interact'] } : {});
+      return session.world.hash();
+    };
+    expect(run()).toBe(run());
+  });
+});
