+/**
+ * @file The playground's crane shot, `cam3=crane` (docs/PLAYGROUND.md §4): a camera mode of the playground's own, for
+ * watching the player run the gym. It is the platformer's orbit-and-follow camera (engine/gfx/cameras/follow.ts: its
+ * recentring, look-ahead and vertical dead zone) with its arm 10 m long, looking down 35°. `cam3=crane,<yaw>` starts
+ * it turned to that heading (degrees); a bare `cam3=crane` keeps the heading of the camera before it. It is not one of
+ * the five modes T steps through (labs/playground/views.ts): `__engine.camera.set('cam3=crane')` or `?cam3=crane`
+ * opens it, the page importing this module.
+ *
+ * Game code, a page's: it imports only the engine's public API (engine/index.ts).
+ *
+ * @example
+ * CRANE.distance; // 10: m, the arm
+ * craneYaw('cam3=crane,90'); // π/2: turned to the east
+ * @see labs/playground/cameras/crane.test.ts
+ */
+import { createFollowCamera, defineCamera } from '../../../engine';
+
+/** The crane's arm (m) and how far it looks down (rad). */
+export const CRANE = Object.freeze({ distance: 10, pitch: (-35 * Math.PI) / 180 });
+
+/** The heading (rad) a code `cam3=crane,<yaw>` gives in degrees; undefined when it gives none. */
+export function craneYaw(code: string): number | undefined {
+  const yaw = code.split(',')[1]?.trim();
+  return yaw ? (Number(yaw) * Math.PI) / 180 : undefined;
+}
+
+defineCamera('crane', {
+  description: 'A crane shot: the platformer camera with a 10 m arm, looking down 35°.',
+  create: (code, { from }) => createFollowCamera({ ...CRANE, yaw: craneYaw(code), from }),
+});
