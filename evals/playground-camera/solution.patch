+/**
+ * @file Unit tests for the playground's crane shot (labs/playground/cameras/crane.ts): `cam3=crane` is a camera code,
+ * its rig settles 10 m from the player looking down 35°, a code's heading turns it, and the page imports it.
+ * @see labs/playground/cameras/crane.ts
+ */
+import { readFileSync } from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { createCameraRig, readCameraCode } from '../../../engine';
+import { CRANE, craneYaw } from './crane';
+
+/** The rig of `code` after `seconds` following the player standing at the origin. */
+function settled(code: string, seconds = 3) {
+  const rig = createCameraRig(code);
+  for (let k = 0; k < seconds * 60; k++) rig.update({ follow: [0, 0, 0] }, 1 / 60);
+  return rig.pose();
+}
+
+describe('the crane shot', () => {
+  it('is a camera code of the playground’s own', () => {
+    expect(readCameraCode('cam3=crane')).toMatchObject({ type: 'game', name: 'crane' });
+  });
+
+  it('settles 10 m from the player, looking down 35°', () => {
+    const pose = settled('cam3=crane');
+    expect(pose.distance).toBeCloseTo(CRANE.distance, 2);
+    expect(pose.pitch).toBeCloseTo(CRANE.pitch, 3);
+  });
+
+  it('turns to the heading its code gives, in degrees', () => {
+    expect(craneYaw('cam3=crane')).toBeUndefined();
+    expect(settled('cam3=crane,90', 1).yaw).toBeCloseTo(Math.PI / 2, 3);
+  });
+
+  it('is imported by the playground’s page', () => {
+    expect(readFileSync('labs/playground/main.ts', 'utf8')).toContain("import './cameras/crane';");
+  });
+});
