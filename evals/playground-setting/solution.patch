@@ -115,4 +116,22 @@ describe('the gym', () => {
     expect(GYM_SPAWN[0] - run.x).toBeGreaterThan(hero.speed * 0.6);
     expect(GYM_SPAWN[0] - run.x).toBeLessThan(hero.speed * 1.01);
   });
+
+  it('jumps as high under another gravity, rising and falling slower under less', async () => {
+    /** The steps from the take-off until the player stands on the floor again, and his highest point. */
+    const airtime = async (gravity: number) => {
+      const engine = await createHeadless({ scene: gym, settings: { 'playground.gym.gravity': gravity } });
+      let [top, steps] = [0, 0];
+      for (let k = 0; k < 180; k++) {
+        engine.step(1, { b: ['jump'], ...(k === 0 ? { p: ['jump'] } : {}) });
+        const [player] = engine.state('actor').entities as unknown as { actor: { y: number } }[];
+        top = Math.max(top, player.actor.y);
+        if (player.actor.y > 1e-3) steps = k + 1;
+      }
+      return { top, steps };
+    };
+    const [apex, moon] = [await airtime(APEX_GRAVITY), await airtime(9.81)];
+    expect(moon.top).toBeCloseTo(APEX_JUMP, 1);
+    expect(moon.steps / apex.steps).toBeCloseTo(Math.sqrt(APEX_GRAVITY / 9.81), 1);
+  });
 });
