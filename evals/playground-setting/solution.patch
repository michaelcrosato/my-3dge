  * number is the height, slope or gap the compiled level holds where its sign says; no two features overlap and each
  * stays inside the perimeter; the player stands at the spawn at the north end; and the settings change play: a faster
- * run covers more ground, a higher jump rises higher, as Apex's numbers set them by default; on the platformer
- * profile (`playground.movement`, WP 13.25) the player runs as the Stress Box hero, untuned by the gym's settings.
+ * run covers more ground, a higher jump rises higher, as Apex's numbers set them by default, and under less gravity he
+ * jumps as high, longer in the air; on the platformer profile (`playground.movement`, WP 13.25) the player runs as the
+ * Stress Box hero, untuned by the gym's settings.
  * @see labs/playground/scenes/gym.ts
  */
 import { describe, expect, it } from 'vitest';
 import { createHeadless } from '../../../engine';
 import { floorHeight, topHeight } from '../../../engine/sim-api';
-import { APEX_JUMP, APEX_RUN, playerCharacter } from '../cast/player';
+import { APEX_GRAVITY, APEX_JUMP, APEX_RUN, playerCharacter } from '../cast/player';
