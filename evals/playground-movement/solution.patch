+/**
+ * @file Unit tests for the gym with a heavy soldier (labs/playground/scenes/gym-heavy.ts, labs/playground/cast/
+ * heavy.ts): the player stands at the gym's spawn on `movement:heavy`, runs and sprints at its speeds, empty-handed,
+ * and jumps its 1.0 m; Apex's player in the gym keeps his.
+ * @see labs/playground/scenes/gym-heavy.ts
+ */
+import { describe, expect, it } from 'vitest';
+import { createHeadless } from '../../../engine';
+import { HEAVY, HEAVY_JUMP } from '../cast/heavy';
+import { gymHeavy } from './gym-heavy';
+
+/** The player's steady speed on the open floor, holding `move` west (and sprint when asked), and his highest jump. */
+async function measure(sprint: boolean) {
+  const engine = await createHeadless({ scene: gymHeavy });
+  const feet = () => (engine.state('actor').entities as unknown as { actor: { x: number } }[])[0].actor.x;
+  const b = sprint ? ['sprint'] : [];
+  engine.step(1, { move: [-1, 0], b, p: b });
+  engine.step(59, { move: [-1, 0], b });
+  const from = feet();
+  engine.step(60, { move: [-1, 0], b });
+  return from - feet();
+}
+
+describe('the gym with a heavy soldier', () => {
+  it('runs and sprints at movement:heavy’s speeds, 1.15 times faster empty-handed', async () => {
+    const { run, sprint, holstered } = HEAVY.model!.gaits;
+    expect(await measure(false)).toBeCloseTo(run * holstered, 1);
+    expect(await measure(true)).toBeCloseTo(sprint * holstered, 1);
+  });
+
+  it('jumps 1.0 m', async () => {
+    const engine = await createHeadless({ scene: gymHeavy });
+    let top = 0;
+    for (let k = 0; k < 60; k++) {
+      engine.step(1, { b: ['jump'], ...(k === 0 ? { p: ['jump'] } : {}) });
+      top = Math.max(top, (engine.state('actor').entities as unknown as { actor: { y: number } }[])[0].actor.y);
+    }
+    expect(top).toBeCloseTo(HEAVY_JUMP, 1);
+  });
+});
