+/**
+ * @file The gym with a heavy soldier, `playground:gym-heavy` (docs/PLAYGROUND.md §2.3, §3.2): the gym of
+ * labs/playground/scenes/gym.ts, its features, rides and dev action `place` the same, its player moving on the
+ * profile `movement:heavy` (labs/playground/cast/heavy.ts) instead of Apex's: a run of 3.6 m/s and a sprint of 5.4
+ * with a weapon out, 1.15 times faster empty-handed, and a 1.0 m jump. The gym's settings (`playground.gym.*`) are
+ * Apex's tuning, so this scene reads none of them.
+ *
+ * Game code, sim-side: it imports only engine/sim-api.ts and the playground's own files.
+ *
+ * @example
+ * // node x sim labs/playground/scenes/gym-heavy --steps 600 --feel
+ * gymHeavy.id; // 'playground:gym-heavy'
+ * @see labs/playground/scenes/gym-heavy.test.ts
+ */
+import { defineScene } from '../../../engine/sim-api';
+import '../cast/heavy';
+import { levelGround, playgroundSounds } from '../sounds/events';
+import { GYM, GYM_ACTIONS, setupGym } from './gym';
+
+/** The gym, its player the heavy soldier. */
+export const gymHeavy = defineScene('playground:gym-heavy', {
+  description: 'The gym with a heavy soldier: the player moves on movement:heavy, slower than Apex, jumping 1.0 m.',
+  level: 'level:gym',
+  physics: true,
+  sounds: playgroundSounds(levelGround(GYM)),
+  setup(w) {
+    setupGym(w, { movement: 'movement:heavy' });
+  },
+  actions: GYM_ACTIONS,
+});
+
+export default gymHeavy;
