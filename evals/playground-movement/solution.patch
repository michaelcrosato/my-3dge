+/**
+ * @file The heavy soldier's movement (docs/PLAYGROUND.md §3.2): the profile `movement:heavy`, a character in armour
+ * on the shooter model. He has `movement:apex`'s hull, steps, slopes, gravity and forgiving details, but runs at
+ * 3.6 m/s and sprints at 5.4 m/s with a weapon out (empty-handed, 1.15 times faster, as Apex's) and jumps 1.0 m; every
+ * other number of the model is Apex's. The playground's gym shows him as `playground:gym-heavy`
+ * (labs/playground/scenes/gym-heavy.ts).
+ *
+ * Game code, sim-side: it imports only engine/sim-api.ts.
+ *
+ * @example
+ * HEAVY.model?.gaits.run; // 3.6: m/s with a weapon out
+ * HEAVY_JUMP; // 1: m
+ * @see labs/playground/scenes/gym-heavy.test.ts
+ */
+import { defineMovement, getMovement } from '../../../engine/sim-api';
+
+/** Apex's profile, whose hull, steps, slopes and gravity the heavy soldier keeps. */
+const APEX = getMovement('movement:apex');
+
+/** How high the heavy soldier jumps (m). */
+export const HEAVY_JUMP = 1;
+
+/** The heavy soldier's profile (see the file comment). */
+export const HEAVY = defineMovement('movement:heavy', {
+  description:
+    'A heavy soldier: Apex’s hull and gravity, but a run of 3.6 m/s, a sprint of 5.4 (×1.15 holstered) and a 1.0 m jump.',
+  character: {
+    ...APEX.character,
+    speed: 3.6,
+    jumpSpeed: Math.sqrt(2 * (APEX.character.characterGravity as number) * HEAVY_JUMP),
+  },
+  model: { gaits: { run: 3.6, sprint: 5.4 } },
+});
