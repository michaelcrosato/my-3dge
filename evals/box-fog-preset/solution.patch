+/**
+ * @file The look `look:moor`: the box on a grey, overcast moor, thick fog closing in past the hero and lying low on
+ * the floor. It is the sky `sky:moor`, defined here, over the scene's own style with no filter: a sunless sky the
+ * colour of wet slate, a soft ambient light from above, range fog from 4 m past the focus, whole at 40 m, and height
+ * fog densest on the floor, gone 2 m up.
+ *
+ * Invariants: data only, the kinds' fields (`node x describe look`, `node x describe sky`): the sky `sky:moor`
+ * (engine/gfx/sky.ts), which a page that starts the engine shows (engine/app/look.ts), the scene's own style, and
+ * every filter it leaves out off. A page draws it when its setting `post.look` names it; a look never changes play.
+ *
+ * @example
+ * look.id; // 'look:moor'
+ * look.sky; // 'sky:moor'
+ * @see labs/box/looks/moor.test.ts
+ */
+import { defineLook, defineSky } from '../../../engine';
+
+/** The sky `sky:moor`: overcast, no sun, thick range fog past the focus and height fog on the floor. */
+export const sky = defineSky('sky:moor', {
+  description: 'A grey, overcast moor: no sun, a soft light from above, thick fog from 4 m past the focus and low on the floor.', // prettier-ignore
+  background: '#8a929a',
+  pointLights: 1,
+  ambient: { sky: '#9aa4ae', ground: '#3a3f44', intensity: 1.4 },
+  fog: { color: '#a7afb7', start: 4, end: 40, amount: 0.9, floor: 0, ceiling: 2, height: 0.6 },
+});
+
+/** The look `look:moor`: the sky `sky:moor` over the scene's own style, no filter. */
+export const look = defineLook('look:moor', {
+  description: 'A grey, overcast moor: thick fog closing in past the hero and lying low on the floor; no filter.',
+  sky: 'sky:moor',
+});
