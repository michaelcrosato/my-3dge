+/**
+ * @file The move `move:whirl`: a low spinning sweep of the sword round the hero's feet. The body turns once to the left
+ * while the blade sweeps from his right to his left on the ground plane, a metre below the shoulder centre, after a
+ * deep crouch; the blade leaves its trail.
+ *
+ * Invariants: angles in radians, + toward the right hand (up on the vertical plane); heights and reaches in metres
+ * from the shoulder centre, reaches at the reference arm; times in seconds; a field left out keeps a plain strike's
+ * value (node x describe move lists the fields with their defaults; getMove('move:slash') is a worked one).
+ *
+ * @example
+ * whirl.spin; // 1: one whole turn to the left during the strike
+ * @see labs/box/moves/whirl.test.ts
+ */
+import { defineMove } from '../../../engine/sim-api';
+
+/** The move `move:whirl`: a low spinning sweep of the sword round the hero's feet. */
+export const whirl = defineMove('move:whirl', {
+  arc: [1.2, -1.2],
+  height: [-1, -1],
+  reach: [0.55, 0.55],
+  spin: 1,
+  body: { lean: 0.2, lunge: 0, crouch: 0.6 },
+  time: { wind: 0.15, active: 0.3, recover: 0.3, hold: 0.25 },
+  gallery: { camera: 'front', duration: 0, states: [] }, // node x gallery: four moments of its swing
+});
