+/**
+ * @file The cabin (docs/PLAYGROUND.md §6.1, §6.2): `level:cabin`, a log cabin of two rooms written as a storey on 0.5 m
+ * tiles (labs/playground/levels/plan.ts), 7 × 4 m outside and 2.6 m high under a flat roof bodies stand on. Its main
+ * room (`room:cabin`, 4 × 3 m inside its walls) has the door in from the outside in its south wall and a window in
+ * its west wall; the bunk room (`room:bunks`, 1.5 × 3 m) lies east of it, through a door in the wall between them.
+ * It stands on no site yet: a level of its own, which `getLevel('level:cabin')` compiles.
+ *
+ * Game code, sim-side: it imports only engine/sim-api.ts and the playground's own files.
+ *
+ * @example
+ * CABIN_TILE; // 0.5: m
+ * @see labs/playground/levels/cabin.test.ts
+ */
+import { defineGlyph, defineLevel } from '../../../engine/sim-api';
+import { levelText, Plan } from './plan';
+
+/** The cabin's tile (m). */
+export const CABIN_TILE = 0.5;
+
+/** The characters marking its rooms (the legend's letters are all taken). */
+export const CABIN_MARKERS = Object.freeze({ cabin: '*', bunks: ';' });
+
+defineGlyph('glyph:playground-cabinRoom', { char: CABIN_MARKERS.cabin, description: "Floor marking the cabin's main room.", mesh: 'floor', room: 'cabin' }); // prettier-ignore
+defineGlyph('glyph:playground-bunks', { char: CABIN_MARKERS.bunks, description: "Floor marking the cabin's bunk room.", mesh: 'floor', room: 'bunks' }); // prettier-ignore
+
+/** The cabin's plan, as a builder works: its walls, the wall between the rooms, the doors, the window, the markers. */
+export const CABIN_PLAN = new Plan(7, 4, CABIN_TILE)
+  .box([0, 0, 7, 4], '#', '.')
+  .line([4.5, 0.5, 5, 3.5], '#') // the wall between the main room and the bunks
+  .line([4.5, 1.5, 5, 2.5], '+') // the door between them, 1 m
+  .line([2, 3.5, 3, 4], '+') // the door in, in the south wall
+  .line([0, 1.5, 0.5, 2.5], ':') // the window, in the west wall
+  .fill([2, 1.5, 2.5, 2], CABIN_MARKERS.cabin)
+  .fill([5.5, 1.5, 6, 2], CABIN_MARKERS.bunks);
+
+/** The cabin's text: one storey, 2.6 m clear, under a flat roof. */
+export const CABIN_TEXT = levelText(
+  { description: 'A log cabin of two rooms on 0.5 m tiles, 7 × 4 m and 2.6 m high under a flat roof.', tile: CABIN_TILE }, // prettier-ignore
+  [{ keys: { storey: 'ground', base: 0, height: 2.6, roof: 'flat' }, plan: CABIN_PLAN }],
+);
+
+defineLevel('level:cabin', { text: CABIN_TEXT, file: 'labs/playground/levels/cabin.ts' });
