+/**
+ * @file Unit tests for the cabin (labs/playground/levels/cabin.ts): it compiles to one storey 2.6 m clear with its
+ * two rooms, each marker inside its own room, a door between them, a door in and a window, and validates clean: every
+ * room reachable, its doors wide enough.
+ * @see labs/playground/levels/cabin.ts
+ */
+import { describe, expect, it } from 'vitest';
+import { getLevel, roomAt, validateLevel } from '../../../engine/sim-api';
+import { CABIN_TEXT } from './cabin';
+
+describe('the cabin', () => {
+  it('compiles to one storey 2.6 m clear and two rooms, the main room and the bunks', () => {
+    const cabin = getLevel('level:cabin');
+    expect(cabin.storeys!.map((storey) => [storey.name, storey.height])).toEqual([['ground', 2.6]]);
+    expect(cabin.rooms!.map((room) => [room.id, room.area]).sort()).toEqual([['room:bunks', 4.5], ['room:cabin', 12]]); // prettier-ignore
+    expect(roomAt(cabin, 2.5, 0, 2)?.id).toBe('room:cabin');
+    expect(roomAt(cabin, 5.75, 0, 2)?.id).toBe('room:bunks');
+  });
+
+  it('has a door between the rooms, a door in and a window, and validates clean', () => {
+    const cabin = getLevel('level:cabin');
+    expect(cabin.openings!.map((opening) => opening.kind).sort()).toEqual(['door', 'door', 'window']);
+    expect(validateLevel(CABIN_TEXT, { file: 'labs/playground/levels/cabin.ts' })).toEqual([]);
+  });
+});
