{
  "name": "my-3dge",
  "version": "0.0.0",
  "private": true,
  "description": "A fully 3D web game engine written and maintained only by AI coding agents: three.js on WebGPU, Rapier physics, gameplay reproducible on the CPU.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.10 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b tsconfig.check.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write --cache .",
    "check": "node tools/checkAll.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "0.21.0",
    "@stdlib/math-base-special-cos": "0.3.1",
    "@stdlib/math-base-special-pow": "0.3.1",
    "@stdlib/math-base-special-sin": "0.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.19.2",
    "@types/three": "0.182.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "61.7.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild": false
  }
}
